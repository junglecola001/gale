{
  "manifest_version": 3,
  "name": "Gale Capture",
  "version": "0.1.0",
  "description": "把浏览器的下载交给 Gale。",
  "key": "",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Gale Capture" },
  "permissions": ["downloads", "cookies", "storage", "nativeMessaging", "notifications", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
